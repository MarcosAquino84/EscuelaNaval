# Configuración de DSpace
DSPACE_ADMIN_EMAIL=admin@biblioteca.local
DSPACE_ADMIN_PASSWORD=CHANGE_ME
DSPACE_ADMIN_FIRSTNAME=Admin
DSPACE_ADMIN_LASTNAME=Biblioteca

# Base de datos DSpace (PostgreSQL)
POSTGRES_DB=dspace
POSTGRES_USER=dspace
POSTGRES_PASSWORD=CHANGE_ME

# Puertos
DSPACE_PORT=8080
DSPACE_UI_PORT=4000
SOLR_PORT=8983
POSTGRES_PORT=5432

# Configuración de desarrollo
DSPACE_ENV=development

# === KOHA CONFIGURATION ===
# Base de datos Koha (MariaDB)
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=koha_biblioteca
MYSQL_USER=koha
MYSQL_PASSWORD=CHANGE_ME

# Koha Settings
KOHA_INSTANCE=biblioteca
KOHA_ADMIN_USER=admin
KOHA_ADMIN_EMAIL=admin@biblioteca.local
KOHA_ADMIN_PASSWORD=CHANGE_ME

# Puertos Koha
KOHA_STAFF_PORT=8081
KOHA_OPAC_PORT=8082
KOHA_DB_PORT=3306
MEMCACHED_PORT=11211

# === AUTH SERVICE CONFIGURATION ===
# Session Secret (generar con: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME

# Environment (development/production)
NODE_ENV=development
